# Required one-time setup, same as the root .env/backend/.dev.vars files:
# copy this to e2e/.env (git-ignored) before running the suite, local or
# remote. Read by both playwright.config.ts (via dotenv) and
# ../scripts/run-e2e.sh.
#
# Leave E2E_BASE_URL unset for a local run — run-e2e.sh then spins up the
# full stack itself (Postgres, wrangler dev, vite dev) and tests against
# http://localhost:5173. This is the normal day-to-day case.
#
# Set E2E_BASE_URL to a real URL (e.g. a staging frontend) to run against
# an already-running remote environment instead: run-e2e.sh then skips
# starting any local servers/database entirely and Playwright points
# straight at this URL. The target environment must already be seeded
# with the same accounts mysql/seed.sql creates for the login-dependent
# journeys to pass — this is NOT something run-e2e.sh seeds for you when
# pointed remotely, since it has no way to reach that environment's
# database.
#
# Never point this at a live/production URL — every journey in this
# suite creates, edits, or deletes real-looking data (students, parents,
# notifications, feature flags, ...); running it against production
# would corrupt real records. Staging (an isolated, disposable
# environment/database) or local are the only appropriate targets.
E2E_BASE_URL=

# Password shared by every seeded test account (helpers/auth.ts's
# SEED_PASSWORD), used to log in throughout the suite — always read from
# here, never hardcoded in the test source (or in this example file —
# see the comment at the top of ../mysql/seed.sql for the actual local
# value to use, deliberately not repeated here so it isn't sitting in two
# tracked files). Pointed at a remote target instead (see E2E_BASE_URL
# above), set this to whatever that target's seed data actually uses, if
# it differs.
E2E_SEED_PASSWORD=

# Only needed when E2E_BASE_URL points at staging — lets this suite's own
# logins skip staging's login rate limiter (backend's rateLimit.ts) so the
# 40+ journeys here, each logging in fresh, don't trip the 10-per-15-min
# limit partway through a full run. Must match the E2E_TEST_BYPASS_SECRET
# Worker secret set on the staging backend (see backend/wrangler.toml and
# staging.yml). Leave blank for a local run or if unset — the header is
# simply omitted and the local stack has no such limiter anyway.
E2E_BYPASS_TOKEN=
