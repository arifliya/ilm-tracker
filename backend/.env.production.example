# Production values for the backend. Copy to backend/.env on the
# production host, fill in real values, and never commit the real file.
# Every value below MUST actually change from the dev defaults in
# backend/.env.example — none of them are safe left as-is in production.
PORT=4000
DB_HOST=db
DB_USER=ilmuser
# Must match MYSQL_PASSWORD in the root .env.production.example
DB_PASSWORD=changeme-generate-a-real-app-password
DB_NAME=ilm

# openssl rand -hex 32 — a real random secret, not the dev placeholder.
# Rotating this invalidates every existing session (same as a mass logout).
JWT_SECRET=changeme-generate-a-random-secret

# openssl rand -hex 32 — a real random secret, not the dev placeholder.
# Signs/verifies the direct-debit provider webhook. If/when this moves off
# the stub provider to a real one (e.g. GoCardless), replace this with the
# webhook secret the real provider gives you instead of one you generate.
DIRECT_DEBIT_WEBHOOK_SECRET=changeme-generate-a-random-secret

# MUST be true — this app is served over HTTPS in production, and a
# non-secure cookie would be sent in plaintext over the wire.
COOKIE_SECURE=true

# The real, public HTTPS origin(s) the frontend is actually served from.
# Never leave this as localhost, and never use "*" — the auth cookie relies
# on this being an exact, trusted origin list.
CORS_ORIGIN=https://app.your-real-domain.example

# Only relevant if a reverse proxy/load balancer sits in front of this
# service (e.g. an ALB, Cloudflare, nginx doing TLS termination). If so,
# set this to the hop count between the client and this app (usually 1)
# so req.ip — and therefore the login/registration rate limiters — reads
# the real client IP from X-Forwarded-For instead of the proxy's IP. Leave
# false if this container is reached directly with no proxy in front.
TRUST_PROXY=1
