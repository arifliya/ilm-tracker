# Copy to .env and fill in real values. Never commit the real .env.
PORT=4000
DB_HOST=db
DB_USER=ilmuser
DB_PASSWORD=changeme-app-password
DB_NAME=ilm
# openssl rand -hex 32
JWT_SECRET=changeme-generate-a-random-secret
# openssl rand -hex 32 — signs/verifies the direct-debit provider webhook
DIRECT_DEBIT_WEBHOOK_SECRET=changeme-generate-a-random-secret
# true in any environment served over HTTPS
COOKIE_SECURE=false
# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
# Express "trust proxy" setting — leave false unless this sits behind a
# reverse proxy/load balancer, then set to a hop count (e.g. 1) or a value
# from https://expressjs.com/en/guide/behind-proxies.html. This controls
# what req.ip (and the login/registration rate limiters) trust.
TRUST_PROXY=false
