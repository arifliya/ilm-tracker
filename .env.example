# Copy to .env and fill in real values. Used by docker-compose to run the
# local Postgres + Liquibase migrations — that's all this stack runs
# locally now; the backend runs via `wrangler dev` and the frontend via
# `vite dev`, neither of which read this file. Never commit the real .env.
POSTGRES_USER=ilmuser
POSTGRES_PASSWORD=changeme-app-password
POSTGRES_DB=ilm
